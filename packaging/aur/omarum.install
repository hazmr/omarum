post_install() {
  echo "==> Omarum is installed. Set it up for your user (not as root):"
  echo "==>     omarum-setup                 # add --with-zonos3 for the ZONOS3-Mini voice"
}

post_upgrade() {
  echo "==> Omarum updated. Restart it with: systemctl --user restart omarum omarum-orb"
}

pre_remove() {
  echo "==> Before removing, run omarum-uninstall as each user who set Omarum up."
}
