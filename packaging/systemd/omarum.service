[Unit]
Description=Omarum voice companion (Rum)
Documentation=file://@REPO@/README.md
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@OMARUM@ daemon
Restart=on-failure
RestartSec=2
# The daemon owns the ZONOS3 server child; stop them together.
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=graphical-session.target
